# Copy this file to keystore.properties and fill in your release keystore details.
# keystore.properties is gitignored so your secrets never reach the repo.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore emberfocus-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias emberfocus
#
storeFile=../emberfocus-release.jks
storePassword=CHANGE_ME
keyAlias=emberfocus
keyPassword=CHANGE_ME
